# Used by `vite build --mode desktop` (the Tauri app). Cross-platform, unlike inline VAR=value scripts.
# A variable already set in the shell wins over this file, so VITE_API_BASE_URL=... can still override it.
VITE_NATIVE=1
# The server the desktop app talks to. Also update app.security.csp connect-src in tauri.conf.json.
VITE_API_BASE_URL=http://localhost:8000
